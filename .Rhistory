library(readr)
Readers_Data <- read_csv("Readers_Data.csv")
View(Readers_Data)
ggplot(Readers_Data, aes(Gender, Weekly_Reading_Time))+
geom_col()
ggplot(Readers_Data, aes(Favorite_Book_Genre, Weekly_Reading_Time))+
geom_col()+
facet_wrap(~Favorite_Book_Genre)
ggplot(Readers_Data, aes(Gender))+
geom_bar()+
facet_wrap(~Favorite_Book_Genre)
ggplot(Readers_Data, aes(Gender, fill = Gender))+
geom_bar()+
facet_wrap(~Favorite_Book_Genre)
ggplot(Readers_Data, aes(Gender, fill = Gender))+
geom_bar(fill(f = 'pink', m='blue'))+
facet_wrap(~Favorite_Book_Genre)
ggplot(Readers_Data, aes(Gender, fill = Gender))+
geom_bar(col = "pink")+
facet_wrap(~Favorite_Book_Genre)
ggplot(Readers_Data, aes(Gender, fill = Gender))+
geom_bar()+
facet_wrap(~Favorite_Book_Genre)
library(RColorBrewer)
ggplot(Readers_Data, aes(Gender, fill = Gender))+
scale_fill_brewer(palette = "Pastel1")
geom_bar()+
facet_wrap(~Favorite_Book_Genre)
library(RColorBrewer)
ggplot(Readers_Data, aes(Gender, fill = Gender))+
scale_fill_brewer(palette = "Pastel1")+
geom_bar()+
facet_wrap(~Favorite_Book_Genre)
library(RColorBrewer)
ggplot(Readers_Data, aes(Gender, fill = Gender))+
scale_fill_brewer(palette = "Pastel1")+
geom_bar()+
facet_wrap(~Favorite_Book_Genre)+
theme_bw()
library(RColorBrewer)
ggplot(Readers_Data, aes(Gender, fill = Gender))+
scale_fill_brewer(palette = "Pastel1")+
geom_bar()+
facet_wrap(~Favorite_Book_Genre)+
theme_bw()+
labs(title = "Genre Distribution Across Gender")
